/* Variáveis de cores verde, rosa e amarelo */
:root {
    --verde-escuro: #2D5A27;
    --verde-claro: #E8F5E9;
    --rosa-principal: #FF8DA1;
    --rosa-fundo: #FFF0F2;
    --amarelo: #FFF176;
    --texto: #333333;
    --tamanho-fonte: 16px;
}

/* Corpo do texto */
body {
    font-family: 'Quicksand', sans-serif;
    font-size: var(--tamanho-fonte);
    color: var(--texto);
    background-color: var(--verde-claro);
    margin: 0;
    padding: 0;
    line-height: 1.6;
}

h1, h2, h3 {
    font-family: 'Fredoka', sans-serif;
    color: var(--verde-escuro);
}

/* Botão de acessibilidade */
.acessibilidade {
    background-color: var(--amarelo);
    padding: 10px;
    text-align: center;
    border-bottom: 3px solid var(--rosa-principal);
}

.btn-acessibilidade {
    background-color: white;
    border: 2px solid var(--verde-escuro);
    padding: 5px 15px;
    font-family: 'Fredoka', sans-serif;
    font-size: 14px;
    cursor: pointer;
    border-radius: 20px;
    transition: 0.3s;
}

.btn-acessibilidade:hover {
    background-color: var(--rosa-principal);
    color: white;
}

/* Cabeçalho do Site */
header {
    background-color: white;
    text-align: center;
    padding: 40px 20px;
    border-radius: 0 0 50px 50px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
}

header h1 {
    font-size: 2.5rem;
    margin: 0;
}

.subtitulo-header {
    color: var(--rosa-principal);
    font-weight: bold;
    font-size: 1.2rem;
}

/* Conteúdo */
.container {
    max-width: 800px;
    margin: 30px auto;
    padding: 20px;
}

/* Estilo dos cards */
section {
    background: white;
    padding: 30px;
    margin-bottom: 30px;
    border-radius: 30px;
    border-left: 8px solid var(--rosa-principal);
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
}

/* Estilização */
ul, ol {
    padding-left: 20px;
}

li {
    margin-bottom: 10px;
}

/* Imagens */
.decoracao-img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 20px auto;
    border-radius: 20px;
    border: 4px dashed var(--amarelo);
}

/* Chat */
.chat-container {
    background-color: var(--rosa-fundo);
    border: 3px solid var(--rosa-principal);
    border-radius: 30px;
    padding: 20px;
    margin-top: 40px;
}

.chat-janela {
    background: white;
    height: 200px;
    overflow-y: auto;
    border-radius: 20px;
    padding: 15px;
    margin-bottom: 15px;
    border: 1px solid #ddd;
}

.mensagem {
    margin-bottom: 12px;
    padding: 8px 12px;
    border-radius: 15px;
    max-width: 80%;
}

.msg-usuario {
    background-color: var(--amarelo);
    margin-left: auto;
    text-align: right;
}

.msg-bot {
    background-color: var(--verde-claro);
    color: var(--verde-escuro);
}

.chat-input-area {
    display: flex;
    gap: 10px;
}

.chat-input-area input {
    flex: 1;
    padding: 12px;
    border: 2px solid var(--rosa-principal);
    border-radius: 20px;
    font-family: inherit;
}

.chat-input-area button {
    background-color: var(--verde-escuro);
    color: white;
    border: none;
    padding: 0 20px;
    border-radius: 20px;
    font-family: 'Fredoka', sans-serif;
    cursor: pointer;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 30px;
    background-color: var(--verde-escuro);
    color: white;
    margin-top: 50px;
    border-radius: 50px 50px 0 0;
}